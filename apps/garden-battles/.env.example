# PACKAGE_ID=0x...
# COLLECTION_PACKAGE_ID=0x...
# MINT_CAP_ID=0x...
# POOL_ID=0x...
# BATTLE_PACKAGE_ID=0x...
# CONFIG_ID=0x...
# TREASURY_ADDRESS=0x...
# PINATA_JWT=...
